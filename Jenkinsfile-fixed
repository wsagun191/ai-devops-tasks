pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'npm install'
                sh 'npm run build'
            }
        }
        stage('Test') {
            steps {
                sh 'npm test'
            }
        }
        stage('Deploy') {
            when {
                branch 'master'
            }
            steps {
                // Dodano poprawny tag z nazwą repozytorium / użytkownika (zmień 'twojanazwa' na swoją)
                sh 'docker build -t twojanazwa/myapp:latest .'
                sh 'docker push twojanazwa/myapp:latest'
            }
        }
    }
}
